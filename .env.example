# Required for upstream request forwarding.
INLAY_UPSTREAM_BASE_URL=https://your-openai-compatible-provider.example/v1

# Loopback-only listener. Do not bind this proxy publicly.
INLAY_HOST=127.0.0.1
INLAY_PORT=8787
INLAY_MAX_BODY_BYTES=10485760
INLAY_UPSTREAM_TIMEOUT_MS=120000

# Optional structural observation for Responses requests. Transport metrics remain available.
INLAY_OBSERVATION=off


# Optional aggregate-only local session history; off when unset.
# Use a dedicated private directory. Recent request rows are never persisted.
# INLAY_HISTORY_DIR=.inlay/history
# INLAY_HISTORY_MAX_SESSIONS=20

# Optional separate Codex trajectory observer: pnpm observe:codex
# INLAY_CODEX_RECORDS_DIR=C:/private-codex/sessions
# INLAY_TRAJECTORY_DIR=C:/private-inlay/trajectories
# INLAY_TRAJECTORY_PORT=8788
# INLAY_TRAJECTORY_MAX_BYTES=536870912
